# =============================================================================
# ShadiDriver — Environment Variables & Secrets Reference
# Copy this file to .env for local deployment.
# NEVER commit the actual .env containing production secrets to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Node Server Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_DB=shadidriver
POSTGRES_USER=shadidriver_admin
POSTGRES_PASSWORD=shadidriver_dev_secret_change_in_prod
POSTGRES_PORT=5432
# Prisma / Connection pooler URL
DATABASE_URL=postgresql://shadidriver_admin:shadidriver_dev_secret_change_in_prod@localhost:5432/shadidriver?schema=public
# Direct unpooled URL (required for migrations)
DIRECT_URL=postgresql://shadidriver_admin:shadidriver_dev_secret_change_in_prod@localhost:5432/shadidriver?schema=public

# -----------------------------------------------------------------------------
# 3. Redis Cache & Idempotency Store
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=shadidriver_redis_dev_secret
REDIS_URL=redis://:shadidriver_redis_dev_secret@localhost:6379

# -----------------------------------------------------------------------------
# 4. Authentication & JWT Configuration
# -----------------------------------------------------------------------------
# Minimum 32-character high-entropy random string
JWT_SECRET=super_secret_ceremonial_jwt_signing_key_32bytes_minimum_length
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# 5. SMS & OTP Gateway (India DLT Registered)
# -----------------------------------------------------------------------------
# MSG91 Configuration
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=SHADID
MSG91_DLT_TE_ID=1207161728392019283
MSG91_OTP_TEMPLATE_ID=64a78bcdef123456

# Fast2SMS Fallback (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# -----------------------------------------------------------------------------
# 6. Payment Gateway (Razorpay / Cashfree)
# -----------------------------------------------------------------------------
# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cashfree Credentials (Alternative/Backup)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST # TEST or PRODUCTION

# -----------------------------------------------------------------------------
# 7. Cloudflare R2 / S3 Object Storage (Private KYC & Media)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=shadidriver-kyc-documents
R2_PUBLIC_BASE_URL=https://documents.shadidriver.in

# -----------------------------------------------------------------------------
# 8. Push Notifications (Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=shadidriver-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shadidriver-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# 9. Maps, Geocoding & Places (India-Optimized)
# -----------------------------------------------------------------------------
# Primary: Google Maps Platform / Ola Maps / MapmyIndia (Mappls)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OLA_MAPS_API_KEY=your_ola_maps_api_key_here
MAPPLS_REST_API_KEY=your_mappls_api_key_here

# -----------------------------------------------------------------------------
# 10. Telemetry, Monitoring & Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN_BACKEND=https://example@o123456.ingest.sentry.io/1234567
SENTRY_DSN_FLUTTER=https://example@o123456.ingest.sentry.io/7654321
LOG_LEVEL=debug # debug, info, warn, error

# -----------------------------------------------------------------------------
# 11. Flutter Client Compile-Time Defines (--dart-define)
# -----------------------------------------------------------------------------
# Base URL for Flutter client API communication
SHADI_API_BASE_URL=http://10.0.2.2:3000/api/v1
# Toggle mock repositories vs live backend client (true for offline dev/tests)
SHADI_USE_MOCK_AUTH=true
SHADI_ENVIRONMENT=development # development, staging, production
