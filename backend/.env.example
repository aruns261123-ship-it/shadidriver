# ============================================================================
# ShadiDriver Backend — Environment Configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# All values below are development placeholders, not production credentials.
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database (PostgreSQL 16 + PostGIS) ---
# Local Docker Compose default; matches infra/docker-compose.yml
DATABASE_URL=postgresql://shadidriver_admin:shadidriver_secret@localhost:5432/shadidriver?schema=public

# --- Redis (rate limiting, OTP store) ---
REDIS_URL=redis://:shadidriver_redis_secret@localhost:6379

# --- JWT ---
# Generate a strong secret: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=shadidriver.api

# --- OTP ---
# Length of generated OTP codes
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
# Development only: log OTP codes to server console instead of sending SMS.
# MUST be false in staging/production.
OTP_DEBUG_LOG=true

# --- Rate limiting (global HTTP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Pricing defaults (development seed policy) ---
DEFAULT_ADVANCE_TOKEN_PERCENTAGE=25.00

# --- CORS / misc ---
ENABLE_SWAGGER=true
ENABLE_REQUEST_LOGGING=true
