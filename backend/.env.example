# ============================================================================
# ShadiDriver Backend — Environment Configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# All values below are development placeholders, not production credentials.
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database (PostgreSQL 16 + PostGIS) ---
# Local Docker Compose default; matches infra/docker-compose.yml
DATABASE_URL=postgresql://shadidriver_admin:shadidriver_secret@localhost:5432/shadidriver?schema=public

# --- Redis (rate limiting, OTP store) ---
REDIS_URL=redis://:shadidriver_redis_secret@localhost:6379

# --- JWT ---
# Generate a strong secret: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=shadidriver.api

# --- OTP ---
# Length of generated OTP codes
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
# Development only: log OTP codes to server console instead of sending SMS.
# MUST be false in staging/production.
OTP_DEBUG_LOG=true

# --- Rate limiting (global HTTP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Pricing defaults (development seed policy) ---
DEFAULT_ADVANCE_TOKEN_PERCENTAGE=25.00

# --- CORS / misc ---
ENABLE_SWAGGER=true
ENABLE_REQUEST_LOGGING=true

# --- Google Sign-In (REAL auth) ---
# One OAuth client ID per platform from Google Cloud Console → APIs &
# Services → Credentials (OAuth client IDs of type Web / Android / iOS).
# The backend REFUSES Google sign-in with an explicit error naming whichever
# of these is missing — never faked. Android IDs must match the signing
# certificate (SHA-1) of the built APK.
# GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- SMS OTP delivery (REAL SMS) ---
# console → development only: OTP codes go to the server log. The app throws
#           at boot when SMS_PROVIDER=console and NODE_ENV=production.
# msg91   → production: requires an MSG91 account with a registered sender ID
#           and an OTP template.
SMS_PROVIDER=console
# SMS_AUTH_KEY=
# SMS_OTP_TEMPLATE_ID=
# SMS_SENDER_ID=
# SMS_MSG91_BASE_URL=https://control.msg91.com/api
# SMS_TRANSACTIONAL_TEMPLATE_ID=  # second, NON-OTP DLT template: booking confirmations
# SMS_MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow
# Development only: include OTP codes in API responses (used by the live E2E
# harness). NEVER set true in production.
OTP_DEBUG_EMIT=false

# --- Payments (REAL gateway behind an abstraction) ---
# mock     → development only; MockPaymentGateway refuses NODE_ENV=production.
# razorpay → real gateway. The app FAILS FAST AT BOOT when any of
#            PAYMENT_KEY_ID / PAYMENT_KEY_SECRET / PAYMENT_WEBHOOK_SECRET is
#            missing — production never runs a gateway that cannot collect.
PAYMENT_GATEWAY=mock
# PAYMENT_KEY_ID=rzp_live_xxxxxxxx
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_API_BASE_URL=https://api.razorpay.com/v1

# --- Media / uploads (partner photos, vehicle documents) ---
# Absolute directory where LocalManagedStorage writes uploaded objects;
# served at /media/*. Default: <cwd>/public/media
# MEDIA_ROOT=/var/lib/shadidriver/media

# ----------------------------------------------------------------------------
# PRODUCTION: set NODE_ENV=production, regenerate JWT secrets
# (`openssl rand -base64 48`), OTP_DEBUG_LOG=false, OTP_DEBUG_EMIT unset,
# SMS_PROVIDER=msg91, PAYMENT_GATEWAY=razorpay, and configure GOOGLE_*_CLIENT_ID.
# Full walkthrough: docs/PRODUCTION_SETUP.md
# ----------------------------------------------------------------------------
